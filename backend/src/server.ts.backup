});


const GEMINI_API_KEY = process.env.GEMINI_API_KEY || 'AISyB4dasdadasdoAzQTztvMF3nYuY0DisMjAwzfXl31hU';

const { RTCPeerConnection, RTCSessionDescription, RTCIceCandidate, nonstandard } = wrtc;
const { RTCAudioSink, RTCAudioSource } = nonstandard;


// Helper to calculate RMS of Int16 audio data
function calculateRMS(samples: Int16Array): number {
    if (samples.length === 0) return 0;
    let sum = 0;
    for (let i = 0; i < samples.length; i++) {
        sum += samples[i] * samples[i];
    }
    return Math.sqrt(sum / samples.length);
}

const INACTIVITY_TIMEOUT_MS = 7000; // 7 seconds
const CONNECTION_MAX_DURATION_MS = 2 * 60 * 1000; // 2 minutes
const AUDIO_ACTIVITY_THRESHOLD = 500; // Threshold for 16-bit audio (range -32768 to 32767)

// Rate Limiter: 5 connections per minute per IP
const connectionLimiter = new RateLimiter(5, 60000);

// Cleanup rate limiter periodically
setInterval(() => connectionLimiter.cleanup(), 60000);

io.on('connection', (socket) => {
  const sessionId = socket.handshake.auth.sessionId as string;
  const userId = socket.handshake.auth.userId ? parseInt(socket.handshake.auth.userId) : null;

  const clientIp = socket.handshake.address;
  if (!connectionLimiter.check(clientIp)) {
      console.log(`Rate limit exceeded for ${clientIp}. Disconnecting.`);
      socket.emit('error', { message: 'Rate limit exceeded. Please try again later.' });
      socket.disconnect(true);
      return;
  }

  console.log('Client connected:', socket.id);
  
  // Max connection duration timer
  const connectionTimeout = setTimeout(() => {
    console.log(`Client ${socket.id} reached max connection time of ${CONNECTION_MAX_DURATION_MS/1000}s. Disconnecting.`);
    socket.disconnect(true);
  }, CONNECTION_MAX_DURATION_MS);

  let geminiSession: GeminiSession | null = null;
  let peerConnection: RTCPeerConnection | null = null;
  let audioSink: any = null;
  let audioSource: any = null;
  
  // Inactivity Detection
  let lastActivity = Date.now();
  let inactivityInterval: NodeJS.Timeout | null = null;

  const updateActivity = () => {
    lastActivity = Date.now();
  };

  // Check for inactivity periodically
  inactivityInterval = setInterval(() => {
    if (Date.now() - lastActivity > INACTIVITY_TIMEOUT_MS) {
        console.log(`Client ${socket.id} inactive for ${INACTIVITY_TIMEOUT_MS/1000}s. Disconnecting.`);
        socket.disconnect(true);
    }
  }, 1000);

  // Initialize WebRTC and Gemini for this client
  const initializeSession = async () => {
    peerConnection = new RTCPeerConnection({
      iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
    });

    // Create Audio Source to send audio to client
    audioSource = new RTCAudioSource();
    const track = audioSource.createTrack();
    peerConnection.addTrack(track);

    // Handle incoming audio from client
    peerConnection.ontrack = (event) => {
      if (event.track.kind === 'audio') {
        console.log('Received audio track from client');
        audioSink = new RTCAudioSink(event.track);
        
        audioSink.ondata = (data: any) => {
            // Check input audio volume
            const samples = data.samples; // Int16Array
            const rms = calculateRMS(samples);
            if (rms > AUDIO_ACTIVITY_THRESHOLD) {
                updateActivity();
            }

            // data.samples is Int16Array (usually 48kHz)
            // Convert to Buffer
            const buffer = Buffer.from(data.samples.buffer);
            
            // Downsample 48k -> 16k for Gemini
            const resampled = AudioConverter.downsample(buffer);
            
            if (geminiSession) {
                geminiSession.sendAudio(resampled);
            }
        };
      }
    };

    peerConnection.onicecandidate = (event) => {
      if (event.candidate) {
        socket.emit('ice-candidate', event.candidate);
      }
    };

    // Initialize Gemini
    geminiSession = new GeminiSession(GEMINI_API_KEY);
    
    geminiSession.on('audio', (audioData: Buffer) => {
        // Gemini sends 24kHz PCM
        // Upsample to 48kHz for WebRTC
        const upsampled = AudioConverter.upsample(audioData);
        
        // Always update activity on Gemini audio response
        updateActivity();

        // Send to WebRTC source
        // RTCAudioSource expects { samples: Int16Array, sampleRate: 48000 }
        const samples = new Int16Array(upsampled.buffer, upsampled.byteOffset, upsampled.length / 2);
        
        // wrtc.nonstandard.RTCAudioSource expects exactly 10ms of audio data
        // 48000 Hz * 0.01 s = 480 samples
        const SAMPLE_RATE = 48000;
        const CHUNK_SIZE = 480; // 10ms at 48kHz

        for (let i = 0; i < samples.length; i += CHUNK_SIZE) {
            if (i + CHUNK_SIZE > samples.length) break; // Skip incomplete chunk

            const chunk = samples.subarray(i, i + CHUNK_SIZE);
            // Create a new Int16Array copy to avoid reference issues
            const chunkCopy = new Int16Array(chunk);
            
            try {
                audioSource.onData({
                    samples: chunkCopy,
                    sampleRate: SAMPLE_RATE
                });
            } catch (error) {
                console.error("Error sending audio chunk:", error);
            }
        }
    });

    geminiSession.on('toolCall', async (toolCall: any) => {
        updateActivity();
        console.log('Tool Call:', toolCall);
        
        // Update Session State Logic
        if (sessionId) {
            try {
                // Fetch previous state to merge config
                const previousStateStr = await redis.get(`session:${sessionId}`);
                const previousState = previousStateStr ? JSON.parse(previousStateStr) : {};
                
                let newState: any = { ...previousState };
                const fc = toolCall.functionCalls[0]; // Assume primary action guides state

                if (fc) {
                    switch(fc.name) {
                        case 'createSession':
                            newState.status = 'IDLE';
                            newState.config = {
                                durationMinutes: fc.args.durationMinutes || 25,
                                parts: fc.args.parts || 1,
                                breakMinutes: fc.args.breakMinutes || 5,
                                goal: fc.args.goal || "Focus Session",
                                currentPart: 1
                            };
                            break;
                        case 'startSession':
                        case 'resumeSession':
                            newState.status = 'RUNNING';
                            break;
                        case 'pauseSession':
                            newState.status = 'PAUSED';
                            break;
                        case 'stopSession':
                            newState.status = 'IDLE';
                            break;
                    }
                    await saveSessionState(sessionId, userId, newState);
                }
            } catch (e) {
                console.error("Error updating session persistence:", e);
            }
        }

        // Forward tool call to client to update UI
        // We expect the client to acknowledge or we just respond to Gemini
        // For now, we respond to Gemini immediately with a success message
        // and tell the client to do the visual part.
        
        const functionResponses = [];

        for (const fc of toolCall.functionCalls) {
             socket.emit('tool-call', {
                 name: fc.name,
                 args: fc.args
             });
             
             // Generate a response for Gemini
             let result = "OK";
             switch(fc.name) {
                 case 'createSession':
                     result = `Session created: ${fc.args.goal}. Waiting to start.`;
                     break;
                 case 'startSession':
                     result = "Timer started.";
                     break;
                 case 'pauseSession':
                     result = "Timer paused.";
                     break;
                 case 'resumeSession':
                     result = "Timer resumed.";
                     break;
                 case 'stopSession':
                     result = "Session stopped.";
                     break;
             }
             
             functionResponses.push({
                 id: fc.id,
                 name: fc.name,
                 response: { result }
             });
        }

        await geminiSession?.sendToolResponse(functionResponses);
    });

    await geminiSession.connect();
  };

  initializeSession();

  // Signaling Handlers
  socket.on('offer', async (offer) => {
    if (!peerConnection) return;
    await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
    const answer = await peerConnection.createAnswer();
    await peerConnection.setLocalDescription(answer);
    socket.emit('answer', answer);
  });

  socket.on('ice-candidate', async (candidate) => {
    if (!peerConnection) return;
    try {
        await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));
    } catch (e) {
        console.error('Error adding received ice candidate', e);
    }
  });

  socket.on('disconnect', () => {
    console.log('Client disconnected');
    clearTimeout(connectionTimeout);
    if (inactivityInterval) clearInterval(inactivityInterval);
    if (geminiSession) geminiSession.close();
    if (peerConnection) peerConnection.close();
    if (audioSink) audioSink.stop();
  });
});

httpServer.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});

